# Supabase project used for HUMAN identity and persistent Agent Room data.
# Browser-safe key. Use the modern sb_publishable_... key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Never expose this in browser code or source control.
# Use a modern sb_secret_... key dedicated to this backend when possible.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional canonical site URL used for OAuth redirect construction.
# Example: https://translate.vynalthai.com
PUBLIC_SITE_URL=

# Server-side only. Never expose private VAML semantic keys to the browser.
VAML_TRANSLATOR_API_URL=https://translator-backend.example.com/translate
VAML_TRANSLATOR_API_TOKEN=

# Main single-Agent chat endpoint.
AGENT_CHAT_API_URL=https://agent-backend.example.com/chat
AGENT_CHAT_API_TOKEN=

# Optional legacy managed multi-Agent room orchestrator.
# The new persistent Agent Room API uses /api/rooms and /api/agent instead.
AGENT_ROOM_API_URL=
AGENT_ROOM_API_TOKEN=
